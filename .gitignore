backend/.env
backend/.env.*
backend/.env.example
backend/.env.production
backend/.env.production.example

my-dashboard/.env
my-dashboard/.env.* 
my-dashboard/.env.example
my-dashboard/.env.production
my-dashboard/.env.production.example
# ...except the production API origin, which is deliberately tracked. Vite
# inlines VITE_* vars into the bundle every visitor downloads, so this value is
# public by construction and there is nothing to protect by hiding it. Keeping
# it in the repo is what lets CI build the frontend: the runner only ever sees
# a git checkout, never the droplet's filesystem. Do NOT add anything secret to
# this file - only VITE_-prefixed, client-visible settings belong in it.
!my-dashboard/.env.production

*.sqlite
*.sqlite3
*.dump
*.sql
*.zip

# Virtualenvs. Deliberately UNANCHORED and wildcarded, for the same reason the
# __pycache__ rule below is: the old `backend/venv/` matched that exact path
# and nothing else, so renaming a venv aside (e.g. venv_broken_old, kept while
# rebuilding the interpreter) instantly offered 6,325 site-packages files up as
# untracked changes and buried the ~70 real ones.
venv/
venv*/
.venv/
env/
backend/uploads/

# Python bytecode. These patterns are deliberately UNANCHORED (no leading
# path): the old `backend/__pycache__/` only matched that one top-level
# directory, so every nested cache - backend/providers/*/__pycache__,
# backend/routers/__pycache__, backend/utils/**/__pycache__ - was still
# offered up by git. 97 .pyc files had already been committed as a result,
# and roughly three quarters of every `git status` was bytecode noise.
__pycache__/
*.py[cod]
*$py.class

# Test/coverage scratch
.pytest_cache/
.coverage
htmlcov/

my-dashboard/node_modules/
my-dashboard/dist/
# The deploy unpacks into dist.new/ and keeps the last build in
# dist.prev/ for rollback; neither should ever look like a local change.
my-dashboard/dist.*/

# Claude Code local machine state (settings.local.json is per-developer)
.claude/
