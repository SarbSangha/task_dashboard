# Backend deployment example
ENVIRONMENT=production
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@host:5432/database
ARCHIVE_DATABASE_URL=postgresql://user:password@host:5432/archive_database

# Frontend / CORS
FRONTEND_URL=https://dashboard.example.com
CORS_ORIGINS=https://dashboard.example.com

# Optional cache. Leave blank to disable Redis bootstrap without warnings.
REDIS_URL=

# Supabase session pooler is strict about client counts; keep overflow off.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
INBOX_PROFILE_LOGGING=false
EDGE_CACHE_PURGE_URL=https://rmwworker.your-workers-subdomain.workers.dev/purge
EDGE_CACHE_PURGE_SECRET=replace-with-the-same-purge-secret-used-in-cloudflare

# IT Profile / Tool Credential Vault
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOOL_CREDENTIAL_ENCRYPTION_KEY=
TOOL_CREDENTIAL_LAUNCH_SECRET=replace-with-a-long-random-launch-secret

# Cookie / auth
COOKIE_SECURE=true
COOKIE_SAMESITE=none
ALLOWED_COMPANY_EMAIL_DOMAINS=@ritzmediaworld.com,@ctm.co.in,@rmwcreative.in,@contenaissance.com,@ritzmediaworld.in

# Optional one-time admin bootstrap
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_ROLES=admin,root
DEFAULT_ADMIN_BOOTSTRAP_PASSWORD=

# Optional R2 storage
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_REGION=auto
R2_PUBLIC_BASE_URL=

# Credit Consumption Report
# Public dashboard address used for the Generation Log's "Open output" links.
# Falls back to FRONTEND_URL when unset.
PUBLIC_DASHBOARD_URL=https://dashboard.example.com
# Comma-separated emails or user ids of test accounts that the
# "Exclude test & admin accounts" export option removes (admins are always removed).
CREDIT_REPORT_EXCLUDED_ACCOUNTS=

# Sheet Activity (Google Sheet edit history; see apps-script/README.md)
# Shared secret Code.gs sends in X-Sheet-Activity-Secret. At least 24 chars;
# unset = the webhook refuses everything.
SHEET_ACTIVITY_WEBHOOK_SECRET=
# Comma-separated spreadsheet IDs allowed to post (the part of the sheet URL
# between /d/ and /edit). Empty = accept any spreadsheet that has the secret.
SHEET_ACTIVITY_SPREADSHEET_IDS=your-spreadsheet-id

# Sheets section: how often registered Google Sheets are read (seconds, min 60).
SHEETS_POLL_INTERVAL_SECONDS=90
